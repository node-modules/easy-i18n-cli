{
  "name": "easy-i18n-cli",
  "version": "2.0.3",
  "description": "easy-i18n-cli",
  "keywords": [
    "i18n"
  ],
  "bin": {
    "easy-i18n-cli": "./bin/easy-i18n-cli.js",
    "translate": "./bin/easy-i18n-cli.js"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "main": "./src/easy-i18n.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/node-modules/easy-i18n-cli.git"
  },
  "dependencies": {
    "chalk": "4",
    "commander": "9",
    "globby": "4",
    "lodash": "4",
    "mkdirp": "^1.0.4",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "eslint": "*",
    "eslint-config-egg": "^12.1.0",
    "eslint-plugin-mocha": "^4.11.0",
    "git-contributor": "1",
    "husky": "*",
    "mocha": "*",
    "nyc": "*",
    "translate-google": "^1.5.0"
  },
  "scripts": {
    "test": "nyc --reporter=lcov --reporter=text mocha",
    "test:coverage": "nyc --reporter=lcov --reporter=text --reporter=html mocha",
    "test:check-coverage": "nyc check-coverage --lines 100 --branches 100 --functions 100 --statements 100",
    "lint": "eslint . --fix",
    "contributor": "git-contributor"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "nyc": {
    "check-coverage": true,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100,
    "exclude": [
      "test/**",
      "coverage/**",
      ".nyc_output/**",
      "**/*.config.js"
    ]
  },
  "license": "MIT"
}
